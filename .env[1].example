DATABASE_URL=postgres://user:password@localhost:5432/classic_agent
# false for localhost or Render internal database URL only.
DB_SSL=false
API_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=
PORT=3000

# Separate password for /staff (minimum 16 characters). Set real values in Render.
STAFF_USERNAME=staff
STAFF_PASSWORD=
# Optional: enables billed AI chat when supplied. Keep private.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
